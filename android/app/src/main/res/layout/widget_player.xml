<?xml version="1.0" encoding="utf-8"?>
<!-- Ana ekran widget'ı: siyah/gri, ince çerçeve; şarkı adı + önceki / oynat / sonraki. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dejavu_sans_mono"
            android:text="muzikit"
            android:textColor="#FF757575"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/dejavu_sans_mono"
            android:maxLines="1"
            android:text="—"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/w_prev"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="önceki"
        android:src="@drawable/ic_w_prev" />

    <ImageButton
        android:id="@+id/w_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="oynat / duraklat"
        android:src="@drawable/ic_w_play" />

    <ImageButton
        android:id="@+id/w_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="sonraki"
        android:src="@drawable/ic_w_next" />
</LinearLayout>
